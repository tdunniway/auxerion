{
 "cleanUrls": true,
 "trailingSlash": false,
 "redirects": [
  {
   "source": "/kept",
   "destination": "/ghost",
   "permanent": true
  },
  {
   "source": "/auxerion",
   "destination": "/",
   "permanent": true
  },
  {
   "source": "/auxerion/company",
   "destination": "/company",
   "permanent": true
  },
  {
   "source": "/auxerion/investors",
   "destination": "/investors",
   "permanent": true
  }
 ],
 "headers": [
  {
   "source": "/assets/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  }
 ]
}